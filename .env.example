# Copiați acest fișier în .env (local / VPS) sau adăugați variabilele în Netlify:
# Site settings → Environment variables.

# Adresa publică a site-ului (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://roby.media

# --- Email formular de contact (SMTP) ---
# Exemple: Google Workspace (smtp.gmail.com, 465, cu „App password”), Zoho, cPanel, Brevo etc.
SMTP_HOST=smtp.exemplu.ro
SMTP_PORT=465
# true pentru portul 465 (SSL), false pentru 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=contact@roby.media
SMTP_PASS=parola-sau-app-password
# Expeditorul afișat (de obicei aceeași adresă ca SMTP_USER)
MAIL_FROM="Roby Media – Site <contact@roby.media>"
# Unde ajung cererile de ofertă (implicit: email-ul din content/site.json)
MAIL_TO=contact@roby.media

# --- Tracking (se încarcă DOAR după acordul pentru cookie-uri) ---
# Google Analytics 4, ex.: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Meta (Facebook) Pixel, ex.: 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=
# TikTok Pixel, ex.: CXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Google Search Console (opțional): codul din meta tag-ul de verificare
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
